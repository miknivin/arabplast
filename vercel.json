{
    "buildCommand": "npm run build",
    "outputDirectory": "build",
    "devCommand": "npm run dev",
    "installCommand": "npm install",
    "headers": [
        {
            "source": "/assets/(.*).pdf",
            "headers": [
                { "key": "Content-Type", "value": "application/pdf" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/((?!.*\\.).*)",
            "destination": "/index.html"
        }
    ]
}